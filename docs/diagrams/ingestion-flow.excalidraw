      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What does this diagram prove? Every guard (extension, size, hash-based idempotency) runs\nBEFORE any embedding call is made -- rejecting bad input is cheap, not a wasted model call.\nNo PDF/DOCX/PPTX parsing, no async/event-driven pipeline, no Kafka -- all v0.3+ roadmap only.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "What does this diagram prove? Every guard (extension, size, hash-based idempotency) runs\nBEFORE any embedding call is made -- rejecting bad input is cheap, not a wasted model call.\nNo PDF/DOCX/PPTX parsing, no async/event-driven pipeline, no Kafka -- all v0.3+ roadmap only.",
      "lineHeight": 1.25
    }
