# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real values. See workspace
# docs/conventions/secrets.md for the full secrets ladder.

# Human-readable app name, shown in /health.
APP_NAME=enterprise-rag-knowledge-assistant

# local | dev | staging | production — see docs/conventions/environments.md
APP_ENV=local

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

# --- Database ---
# Matches deploy/local/docker-compose.yml. Use "db" instead of "localhost" when the app itself
# runs inside Docker Compose (already set via that file's `environment:` override).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- LLM / embedding provider (see docs/adr/0001-llm-provider-boundary.md) ---
# ollama (default, local, free) | openai (external, requires LLM_API_KEY)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Ollama ignores this value; required by the OpenAI client shape. Set a real key for openai.
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:0.5b
LLM_EMBEDDING_MODEL=all-minilm
EMBEDDING_DIMENSIONS=384

# --- Chunking / retrieval ---
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=100
RETRIEVAL_TOP_K=4
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
